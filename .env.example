# Copy to .env for local runs. Never commit .env or a tokens file.
MCP_OPS_HOST=127.0.0.1
MCP_OPS_PORT=8000
# Data backend: "sqlite" (default) or "fhir".
MCP_OPS_BACKEND=sqlite
# SQLite path. ":memory:" (default) reseeds on every start; a file path persists bookings,
# encrypted with MCP_OPS_DATA_KEY (one server process per file).
MCP_OPS_DB=:memory:
# FHIR R4 base URL, used when MCP_OPS_BACKEND=fhir. It must be https:// (http:// only for
# localhost, as here). The server refuses to start if it is not, or if it is unreachable,
# not R4, or has no synthetic seed (load one with
#   python -m mcp_ops_server.backends.fhir_seed load --url <url>).
MCP_OPS_FHIR_URL=http://127.0.0.1:8080/fhir

# Auth (required: a tokens file, OAuth JWTs, or both). The tokens file (format 2) holds
# SHA-256 hashes; each token names its audience and expiry. Create one and print a token:
#   python -m mcp_ops_server.auth issue --file tokens.json --client dev \
#     --scope read:schedule --scope write:schedule --scope read:referrals [--patient PAT-0008] \
#     [--expires-in-days 90] [--audience mcp-ops-server]
# Revoke on a running server (no restart):  ... revoke --file tokens.json --client dev
# A tokens file from before Part 9 (no "version") is refused; convert it once with
#   python -m mcp_ops_server.auth migrate --file tokens.json
MCP_OPS_TOKENS_FILE=tokens.json
# The audience this server accepts (default mcp-ops-server). Tokens for any other are refused.
MCP_OPS_AUDIENCE=
# OAuth 2.1 JWT access tokens from your authorization server (optional): its issuer, its
# JWKS (a file, or an https:// URL), and a file of revoked jti values that a running server
# re-reads. The file must exist at start-up: create it once with
#   python -m mcp_ops_kit.oauth init --file revoked.json
# then revoke with: python -m mcp_ops_kit.oauth revoke --file revoked.json --jti <jti>
MCP_OPS_JWT_ISSUER=
MCP_OPS_JWT_JWKS=
MCP_OPS_JWT_REVOKED_FILE=

# Audit log and data key (both required; the server will not start without them). Every tool
# call is written to the audit log, encrypted and hash-chained. The key also encrypts a SQLite
# database file. Generate it with python -m mcp_ops_kit.crypto new-key, and keep it in your
# secret store, never in a file next to the data. Check the log with
#   python -m mcp_ops_kit.audit verify --file audit.log --key-env MCP_OPS_DATA_KEY
MCP_OPS_AUDIT_LOG=audit.log
MCP_OPS_DATA_KEY=

# Limits. Tool calls per client per minute (bursts up to this many):
MCP_OPS_RATE_LIMIT_PER_MIN=120
# Larger HTTP request bodies get 413:
MCP_OPS_MAX_BODY_BYTES=65536
# Seconds; bounds lock wait, database busy wait, and statement execution for each call:
MCP_OPS_CALL_TIMEOUT_S=5
MCP_OPS_MAX_SESSIONS=100
MCP_OPS_SESSION_IDLE_TIMEOUT_S=600

# Simulated clinic time (ISO, clinic-local). Default 2026-11-02T08:00, the schedule's first
# Monday morning, so the synthetic data never goes stale. "system" uses the real clock.
# Any real deployment must set "system" (infra/aws does): the default never moves.
MCP_OPS_NOW=2026-11-02T08:00:00

# Live evals only (python -m evals.run --agent openai --model <id>). Not used by the server.
# In CI it is a secret of the "live-evals" environment (main only), used only by the manual
# Live evals workflow.
OPENAI_API_KEY=

# Tests only. Backends the test suite runs against (CI's fhir job: sqlite,fhir), and the FHIR
# server those tests use. That server's data is overwritten: never point it at real data.
MCP_OPS_TEST_BACKENDS=sqlite
MCP_OPS_TEST_FHIR_URL=http://127.0.0.1:8080/fhir

# Salon example (python -m salon_ops): the same settings with the SALON_OPS_ prefix, on port
# 8100 by default, with the salon's own tokens file:
#   python -m salon_ops.auth issue --file salon-tokens.json --client dev \
#     --scope read:catalog --scope write:bookings --scope read:customers [--customer CUS-0005]
SALON_OPS_PORT=8100
SALON_OPS_TOKENS_FILE=salon-tokens.json
SALON_OPS_AUDIT_LOG=salon-audit.log
SALON_OPS_DATA_KEY=
# Simulated salon time (salon-local); default 2026-11-02T18:00, the evening before it opens.
SALON_OPS_NOW=2026-11-02T18:00:00
