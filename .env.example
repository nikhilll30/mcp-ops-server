# Copy to .env for local runs. Never commit .env or a tokens file.
MCP_OPS_HOST=127.0.0.1
MCP_OPS_PORT=8000
# SQLite path. ":memory:" (default) reseeds on every start; a file path persists bookings.
MCP_OPS_DB=:memory:

# Auth (required; the server will not start without it). JSON file of SHA-256 token hashes.
# Create one and print a token:
#   python -m mcp_ops_server.auth issue --file tokens.json --client dev \
#     --scope read:schedule --scope write:schedule --scope read:referrals [--patient PAT-0008]
MCP_OPS_TOKENS_FILE=tokens.json

# Limits. Tool calls per client per minute (bursts up to this many):
MCP_OPS_RATE_LIMIT_PER_MIN=120
# Larger HTTP request bodies get 413:
MCP_OPS_MAX_BODY_BYTES=65536
# Seconds; bounds lock wait, database busy wait, and statement execution for each call:
MCP_OPS_CALL_TIMEOUT_S=5
MCP_OPS_MAX_SESSIONS=100
MCP_OPS_SESSION_IDLE_TIMEOUT_S=600

# Simulated clinic time (ISO, clinic-local). Default 2026-11-02T08:00, the schedule's first
# Monday morning, so the synthetic data never goes stale. "system" uses the real clock.
MCP_OPS_NOW=2026-11-02T08:00:00

# Live evals only (python -m evals.run --agent openai --model <id>). Not used by the server.
# In CI it is a secret of the "live-evals" environment (main only), used only by the manual
# Live evals workflow.
OPENAI_API_KEY=
